---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { services, site } from '../data/site';
const title = 'Electrical Services in Vancouver | Pacific Spirit Electrical';
const description = 'Residential and light commercial electrical services from a Red Seal electrician serving Vancouver and the Lower Mainland, including panel upgrades, EV chargers, heat pumps, lighting, and repairs.';
const popularServices = [
  { label: 'Panel Upgrades', icon: services[1].icon },
  { label: 'EV Chargers', icon: services[2].icon },
  { label: 'Troubleshooting & Repairs', icon: services[6].icon },
  { label: 'Lighting Installation', icon: services[5].icon },
];
---
<BaseLayout {title} {description} path="/services/">
  <section class="page-hero services-hero"><div class="shell services-hero__grid"><div><p class="eyebrow">Electrical Services</p><h1><span class="services-hero__title-line">Electrical services</span><span class="services-hero__title-line">for Vancouver homes</span><span class="services-hero__title-line">&amp; businesses.</span></h1><p>From troubleshooting and repairs to panel upgrades, EV chargers, lighting, renovations, and home electrification, get practical electrical support for your property.</p><div class="services-hero__actions"><a class="button services-hero__primary" href="/contact/">Request a Free Quote</a><a class="button button--outline" href={`tel:${site.telephone}`}><Icon name="phone" /> Call {site.phone}</a></div><p class="page-hero__creds">{site.qualification} · {site.businessType} · {site.serviceArea} · {site.freeEstimates ? 'Free Estimates' : ''}</p></div><aside class="services-hero__popular" aria-label="Popular services"><p class="eyebrow">Popular Services</p><div>{popularServices.map((service) => <span><Icon name={service.icon} />{service.label}</span>)}</div></aside></div></section>
  <section class="section"><div class="shell"><div class="section__head"><div><p class="eyebrow">Our Services</p><h2>Electrical support for every stage of your property.</h2></div><p>Explore services for repairs, upgrades, renovations, new equipment, and changing electrical needs.</p></div><div class="grid service-grid services-grid">{services.map((service) => <article class="service-card" id={service.id}><span class="service-card__icon"><Icon name={service.icon} /></span><div><h3>{service.title}</h3><p>{service.description}</p></div><a href={`/contact/?service=${encodeURIComponent(service.title)}`}>Ask about this service <Icon name="arrow" /></a></article>)}</div></div></section>
  <section class="cta services-cta"><div class="shell cta__inner"><div><p class="eyebrow">Need electrical help?</p><h2>Start with a call or an email.</h2><p>Tell us about the electrical work you are considering, where you are located, and how we can help.</p></div><div class="cta__actions"><a class="button" href={`tel:${site.telephone}`}><Icon name="phone" /> Call {site.phone}</a><a class="button button--outline" href="/contact/"><Icon name="mail" /> Request a Quote</a><a class="cta__whatsapp" href="https://wa.me/17788798210" target="_blank" rel="noopener noreferrer">WhatsApp <Icon name="arrow" /></a></div></div></section>
</BaseLayout>
