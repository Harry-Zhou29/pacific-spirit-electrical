---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { services, site } from '../data/site';
const title = 'Residential Electrical Services in Vancouver | Pacific Spirit Electrical';
const description = 'Residential & commercial electrical services from a Red Seal electrician in Greater Vancouver — panel upgrades, EV chargers, heat pumps, lighting, repairs & more. Free estimates.';
---
<BaseLayout {title} {description} path="/services"><section class="page-hero"><div class="shell"><p class="eyebrow">Residential services</p><h1>Electrical work for real homes and real plans.</h1><p>From a focused repair to a larger improvement, Pacific Spirit Electrical provides residential electrical services for Vancouver and Greater Vancouver homeowners.</p><p class="page-hero__creds">{site.qualification} · {site.businessType} · {site.serviceArea} · {site.freeEstimates ? 'Free Estimates' : ''}</p></div></section><section class="section"><div class="shell"><div class="section__head"><div><p class="eyebrow">Our services</p><h2>Clear support for your home’s electrical needs.</h2></div><p>Explore the residential services available for your next project, update, or electrical concern.</p></div><div class="grid service-grid">{services.map((service) => <article class="service-card" id={service.id}><span class="service-card__icon"><Icon name="bolt" /></span><div><h2 style="font-size:1.4rem">{service.title}</h2><p>{service.description}</p></div><a href={`mailto:${site.email}?subject=${encodeURIComponent(service.title)}`}>Ask about this service <Icon name="arrow" /></a></article>)}</div></div></section><section class="cta"><div class="shell cta__inner"><div><p class="eyebrow">Need electrical help?</p><h2>Start with a call or an email.</h2><p>Tell us about the electrical work you are considering, where you are located, and how we can help.</p></div><a class="button" href={`tel:${site.telephone}`}><Icon name="phone" /> Call {site.phone}</a><a class="button button--outline" href={`mailto:${site.email}?subject=Free%20Quote%20Request`}><Icon name="mail" /> Request a Quote</a></div></section></BaseLayout>
