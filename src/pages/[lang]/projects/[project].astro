---
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return ['zh', 'es'].map((lang) => ({
    params: { lang, project: 'bathroom-vanity-lighting-upgrade' },
    props: { lang },
  }));
}

const { lang } = Astro.props as { lang: 'zh' | 'es' };
const isChinese = lang === 'zh';
const title = isChinese
  ? '浴室镜前灯与调光开关升级 | Pacific Spirit Electrical'
  : 'Iluminación de baño y reguladores | Pacific Spirit Electrical';
const description = isChinese
  ? '近期浴室照明案例：升级镜前灯并安装调光开关，让日常照明更舒适、更灵活。'
  : 'Proyecto reciente de iluminación de baño con nuevos apliques de tocador y reguladores para un uso más cómodo y flexible.';
const path = `/${lang}/projects/bathroom-vanity-lighting-upgrade/`;
---

<!-- This build-time route is replaced with the fully localized English page by the localization script. -->
<BaseLayout {title} {description} {path}>
  <section class="page-hero">
    <div class="shell">
      <h1>{isChinese ? '浴室镜前灯与调光开关升级' : 'Iluminación de baño y reguladores'}</h1>
    </div>
  </section>
</BaseLayout>
