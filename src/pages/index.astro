---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { services, site } from '../data/site';
const serviceLinks: Record<string, string> = {
  'Electrical Panel Upgrades': '/services/electrical-panel-upgrades/',
  'EV Charger Installation': '/services/ev-charger-installation/',
};
const title = 'Electrician in Vancouver | Pacific Spirit Electrical';
const description = 'Red Seal electrician offering residential and light commercial electrical services across Vancouver and the Lower Mainland, including panel upgrades, EV chargers, lighting, renovations, and more.';
---
<BaseLayout {title} {description} path="/">
  <section class="hero">
    <div class="hero__visual" aria-hidden="true"></div>
    <div class="shell hero__inner">
      <div class="hero__content">
        <p class="hero__eyebrow">Trusted electrical services in Vancouver</p>
        <h1><span class="hero__title-line">Safe. Reliable.</span><span class="hero__title-line">Powering Your Home<span class="hero__period" aria-hidden="true">.</span></span></h1>
        <p class="lead">From panel upgrades to EV chargers and everything in between, quality electrical work you can count on.</p>
        <div class="hero__actions">
          <a class="button hero__primary" href="/contact/#quote-form"><Icon name="bolt" /> Get a Free Quote</a>
          <a class="button button--outline" href="/services/">View Services <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>
  <section class="trust-strip" aria-label="Why choose Pacific Spirit Electrical">
    <div class="shell trust-strip__inner">
      <article><span class="trust-strip__icon"><Icon name="bolt" /></span><div><strong>Red Seal Expertise</strong><small>{site.qualification}</small></div></article>
      <article><span class="trust-strip__icon"><Icon name="home" /></span><div><strong>Residential &amp; Light Commercial</strong><small>Practical electrical solutions</small></div></article>
      <article><span class="trust-strip__icon"><Icon name="arrow" /></span><div><strong>Reliable Service</strong><small>Quality work, done right</small></div></article>
      <article><span class="trust-strip__icon"><Icon name="map" /></span><div><strong>Vancouver &amp; the Lower Mainland</strong><small>Local electrical service</small></div></article>
    </div>
  </section>
  <section class="section section--white"><div class="shell"><div class="section__head"><div><p class="eyebrow">What we do</p><h2>Useful electrical expertise, close to home.</h2></div><p>Whether you are resolving an issue, making space for new technology, or renovating a room, the work starts with understanding what your home needs.</p></div><div class="grid service-grid">{services.slice(0,4).map((service) => <article class="service-card"><span class="service-card__icon"><Icon name={service.icon} /></span><div><h3>{service.title}</h3><p>{service.description}</p></div><a href={serviceLinks[service.title] ?? '/services/'}>Learn more <Icon name="arrow" /></a></article>)}</div><p style="margin-top:1.5rem"><a class="button button--outline" href="/services/">View all residential services <Icon name="arrow" /></a></p></div></section>
  <section class="section project-showcase" aria-labelledby="project-showcase-title"><div class="shell"><div class="section__head project-showcase__head"><div><p class="eyebrow">Project Showcase</p><h2 id="project-showcase-title">A growing collection of completed work.</h2></div><p>Explore recent residential and commercial installations. New projects will be added here while earlier case studies remain available.</p></div><div class="project-showcase__grid"><article class="project-showcase__card"><a class="project-showcase__image" href="/projects/commercial-centre-cctv-installation/"><img src="/images/projects/commercial-centre-cctv/cctv-camera-01.jpg" width="1200" height="900" alt="Exterior CCTV camera installed at a commercial centre" loading="lazy" decoding="async" /></a><div class="project-showcase__body"><p class="project-showcase__type">Commercial CCTV · Lower Mainland</p><h3><a href="/projects/commercial-centre-cctv-installation/">Commercial Centre CCTV Installation</a></h3><p>Exterior CCTV cameras installed across high-level commercial areas with protected conduit routing and practical coverage planning.</p><a class="project-showcase__link" href="/projects/commercial-centre-cctv-installation/">View the project <Icon name="arrow" /></a></div></article><article class="project-showcase__card"><a class="project-showcase__image" href="/projects/warehouse-cctv-installation/"><img src="/images/projects/warehouse-cctv-camera-1.webp" width="1080" height="1350" alt="Completed Wi-Fi CCTV camera installation in a Vancouver warehouse" loading="lazy" decoding="async" /></a><div class="project-showcase__body"><p class="project-showcase__type">Commercial CCTV · Vancouver</p><h3><a href="/projects/warehouse-cctv-installation/">Warehouse CCTV Installation</a></h3><p>Two securely mounted Wi-Fi cameras with new nearby power points, mobile app setup, and final coverage and recording tests.</p><a class="project-showcase__link" href="/projects/warehouse-cctv-installation/">View the project <Icon name="arrow" /></a></div></article><article class="project-showcase__card"><a class="project-showcase__image" href="/projects/bathroom-vanity-lighting-upgrade/"><img src="/images/projects/vanity-completed.webp" width="1120" height="1400" alt="Completed bathroom vanity lighting installation" loading="lazy" decoding="async" /></a><div class="project-showcase__body"><p class="project-showcase__type">Residential Lighting · Lower Mainland</p><h3><a href="/projects/bathroom-vanity-lighting-upgrade/">Bathroom Vanity Lighting &amp; Dimmer Upgrade</a></h3><p>Two updated vanity fixtures with compatible slide dimmers for brighter, more flexible everyday lighting.</p><a class="project-showcase__link" href="/projects/bathroom-vanity-lighting-upgrade/">View the project <Icon name="arrow" /></a></div></article></div></div></section>
  <section class="section section--navy"><div class="shell"><p class="eyebrow">Why choose Pacific Spirit Electrical</p><h2>Professional electrical work, handled with care.</h2><div class="grid reason-grid"><article class="reason"><span class="reason__icon"><Icon name="shield-check" /></span><h3>Safety-first work</h3><p>Careful electrical work planned around safety, reliability, and the needs of your property.</p></article><article class="reason"><span class="reason__icon"><Icon name="message" /></span><h3>Clear communication</h3><p>Straightforward explanations of the issue, available options, and recommended next steps.</p></article><article class="reason"><span class="reason__icon"><Icon name="home-check" /></span><h3>Respect for your home</h3><p>Thoughtful, tidy work with attention to your home, schedule, and priorities.</p></article></div></div></section>
  <section class="section section--white"><div class="shell grid feature-grid"><article class="feature"><p class="eyebrow">Vancouver’s Older Homes</p><h2>Older Home Electrical Upgrades</h2><p class="feature__support">Respecting what is already there.</p><p>Older homes often come with their own electrical considerations. Upgrade work benefits from a careful look at the existing system and the plans you have for the space.</p><a class="button button--outline" href="/services/#older-homes">Older home upgrades <Icon name="arrow" /></a></article><article class="feature feature--dark"><p class="eyebrow">Home Electrification</p><h2>EV Chargers &amp; Heat Pump Electrical</h2><p class="feature__support">Ready for what is next.</p><p>EV chargers and heat pumps can change how your home uses power. Electrical planning helps those improvements fit into the bigger picture.</p><a class="button button--outline" href="/services/#ev-heat-pumps">EV & heat pump work <Icon name="arrow" /></a></article></div></section>
  <section class="section"><div class="shell area-panel"><div><p class="eyebrow">Service area</p><h2>Serving Vancouver &amp; the Lower Mainland.</h2><p>Based in Vancouver, Pacific Spirit Electrical provides residential and light commercial electrical services across Vancouver and surrounding Lower Mainland communities.</p><a class="button button--outline" href="/service-areas/">Explore service areas <Icon name="arrow" /></a></div><div class="area-art"><div class="area-art__content"><span class="area-art__icon"><Icon name="location" /></span><ul><li>Vancouver</li><li>Burnaby</li><li>Richmond</li><li>North Shore</li><li>New Westminster</li><li>Nearby Lower Mainland Areas</li></ul><p>Contact us to confirm availability in your area.</p></div></div></div></section>
  <section class="cta homepage-cta"><div class="shell cta__inner"><div><p class="eyebrow">Start Your Project</p><h2>Ready to discuss your electrical project?</h2><p>Tell us what you need and where the project is located. Call, message us on WhatsApp, or request a quote for electrical work in Vancouver and the Lower Mainland.</p></div><div class="cta__actions"><a class="button cta__primary" href="/contact/#quote-form">Request a Free Quote</a><a class="button button--outline" href={`tel:${site.telephone}`}><Icon name="phone" /> Call {site.phone}</a><a class="cta__whatsapp" href="https://wa.me/17788798210" target="_blank" rel="noopener noreferrer">WhatsApp <Icon name="arrow" /></a></div></div></section>
</BaseLayout>
