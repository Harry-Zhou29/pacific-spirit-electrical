---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { services, site } from '../data/site';
const title = 'Residential Electrician in Vancouver | Pacific Spirit Electrical';
const description = 'Red Seal electrician offering residential & commercial electrical services across Greater Vancouver — panel upgrades, EV chargers, lighting, renovations & more. Free estimates.';
---
<BaseLayout {title} {description} path="/">
  <section class="hero">
    <div class="hero__visual" aria-hidden="true"></div>
    <div class="shell hero__inner">
      <div class="hero__content">
        <p class="hero__eyebrow">Trusted electrical services in Vancouver</p>
        <h1><span class="hero__title-line">Safe. Reliable.</span><span class="hero__title-line">Powering Your Home<span class="hero__period" aria-hidden="true">.</span></span></h1>
        <p class="lead">From panel upgrades to EV chargers and everything in between, quality electrical work you can count on.</p>
        <div class="hero__actions">
          <a class="button hero__primary" href={`mailto:${site.email}?subject=Free%20Quote%20Request`}><Icon name="bolt" /> Get a Free Quote</a>
          <a class="button button--outline" href="/services/">View Services <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>
  <section class="trust-strip" aria-label="Why choose Pacific Spirit Electrical">
    <div class="shell trust-strip__inner">
      <article><span class="trust-strip__icon"><Icon name="bolt" /></span><div><strong>Red Seal Expertise</strong><small>{site.qualification}</small></div></article>
      <article><span class="trust-strip__icon"><Icon name="home" /></span><div><strong>Residential &amp; Commercial</strong><small>Practical electrical solutions</small></div></article>
      <article><span class="trust-strip__icon"><Icon name="arrow" /></span><div><strong>Reliable Service</strong><small>Quality work, done right</small></div></article>
      <article><span class="trust-strip__icon"><Icon name="map" /></span><div><strong>Greater Vancouver</strong><small>Local electrical service</small></div></article>
    </div>
  </section>
  <section class="section section--white"><div class="shell"><div class="section__head"><div><p class="eyebrow">What we do</p><h2>Useful electrical expertise, close to home.</h2></div><p>Whether you are resolving an issue, making space for new technology, or renovating a room, the work starts with understanding what your home needs.</p></div><div class="grid service-grid">{services.slice(0,4).map((service) => <article class="service-card"><span class="service-card__icon"><Icon name="bolt" /></span><div><h3>{service.title}</h3><p>{service.description}</p></div><a href="/services/">Learn more <Icon name="arrow" /></a></article>)}</div><p style="margin-top:1.5rem"><a class="button button--outline" href="/services/">View all residential services <Icon name="arrow" /></a></p></div></section>
  <section class="section section--navy"><div class="shell"><p class="eyebrow">Why choose Pacific Spirit Electrical</p><h2>A calm, professional approach to electrical work.</h2><div class="grid reason-grid"><article class="reason"><h3>Homeowner-focused</h3><p>Residential electrical work explained in plain language, with your home and priorities kept front of mind.</p></article><article class="reason"><h3>Clear next steps</h3><p>From the first conversation, the aim is to make it easier to understand what needs attention and why.</p></article><article class="reason"><h3>Local perspective</h3><p>Focused on Vancouver and Greater Vancouver homes, from established neighbourhoods to evolving spaces.</p></article></div></div></section>
  <section class="section"><div class="shell"><div class="section__head"><div><p class="eyebrow">Residential electrical services</p><h2>Work that supports the way your home is changing.</h2></div><a class="button button--outline" href="/services/">All services <Icon name="arrow" /></a></div><div class="grid service-grid">{services.slice(4).map((service) => <article class="service-card"><span class="service-card__icon"><Icon name="bolt" /></span><div><h3>{service.title}</h3><p>{service.description}</p></div><a href="/services/">Learn more <Icon name="arrow" /></a></article>)}</div></div></section>
  <section class="section section--white"><div class="shell grid feature-grid"><article class="feature"><p class="eyebrow">Vancouver’s older homes</p><h2>Respecting what is already there.</h2><p>Older homes often come with their own electrical considerations. Upgrade work benefits from a careful look at the existing system and the plans you have for the space.</p><a class="button button--outline" href="/services/#older-homes">Older home upgrades <Icon name="arrow" /></a></article><article class="feature feature--dark"><p class="eyebrow">Home electrification</p><h2>Ready for what is next.</h2><p>EV chargers and heat pumps can change how your home uses power. Electrical planning helps those improvements fit into the bigger picture.</p><a class="button button--outline" href="/services/#ev-heat-pumps">EV & heat pump work <Icon name="arrow" /></a></article></div></section>
  <section class="section"><div class="shell area-panel"><div><p class="eyebrow">Service area</p><h2>Serving Vancouver and Greater Vancouver.</h2><p>Pacific Spirit Electrical is focused on residential homeowners across Vancouver and the surrounding Greater Vancouver area.</p><a class="button button--outline" href="/service-areas/">Explore service areas <Icon name="arrow" /></a></div><div class="area-art" aria-hidden="true"><Icon name="map" /></div></div></section>
  <section class="cta"><div class="shell cta__inner"><div><p class="eyebrow">Start the conversation</p><h2>Tell us what you are planning.</h2><p>For residential electrical work in Vancouver or Greater Vancouver, get in touch by email and share a little about your home and project.</p></div><a class="button" href={`mailto:${site.email}?subject=Free%20Quote%20Request`}><Icon name="mail" /> Request a Quote</a></div></section>
</BaseLayout>
