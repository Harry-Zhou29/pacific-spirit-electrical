---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
const title = 'About Pacific Spirit Electrical | Vancouver, BC';
const description = 'Meet Harry Zhou, a Red Seal Electrician providing residential and light commercial electrical service across Vancouver and nearby Lower Mainland communities.';
---
<BaseLayout {title} {description} path="/about/">
  <section class="page-hero about-hero"><div class="shell about-hero__grid"><div><p class="eyebrow">About Pacific Spirit Electrical</p><h1>Local electrical service, built around clear communication.</h1><p>Pacific Spirit Electrical provides practical residential and light commercial electrical work across Vancouver and nearby Lower Mainland communities.</p><div class="about-hero__actions"><a class="button about-hero__primary" href="/contact/#quote-form">Request a Free Quote</a><a class="button button--outline" href={`tel:${site.telephone}`}><Icon name="phone" /> Call {site.phone}</a></div></div><aside class="about-credentials" aria-label="Professional electrical service credentials"><p class="eyebrow">Professional Electrical Service</p><div class="about-credentials__list"><article><Icon name="shield-check" /><div><strong>Red Seal Electrician</strong><small>Qualified electrical expertise</small></div></article><article><Icon name="location" /><div><strong>Vancouver Based</strong><small>Local service across the Lower Mainland</small></div></article><article><Icon name="home" /><div><strong>Residential &amp; Light Commercial</strong><small>Practical support for homes and businesses</small></div></article><article><Icon name="clipboard-check" /><div><strong>Free Estimates</strong><small>A clear starting point for your project</small></div></article></div></aside></div></section>
  <section class="section section--white"><div class="shell about-story"><div><p class="eyebrow">About the Electrician</p><h2>Practical expertise. Straightforward service.</h2></div><div class="about-story__copy"><p>Pacific Spirit Electrical is led by Harry Zhou, a Red Seal Electrician based in Vancouver. The business is focused on practical electrical solutions for homeowners and light commercial clients across Vancouver and nearby Lower Mainland communities.</p><p>Harry brings a careful, methodical approach to troubleshooting, upgrades, installations, and electrical planning. The goal is to explain the work clearly, understand the priorities of each property, and provide a dependable next step.</p></div></div></section>
  <section class="section about-work"><div class="shell"><div class="about-work__head"><p class="eyebrow">How We Work</p><h2>A clear process from first conversation to next step.</h2></div><div class="grid about-work__grid"><article><span><Icon name="troubleshoot" /></span><h3>Listen &amp; Assess</h3><p>Start by understanding the property, the issue, and what you want to accomplish.</p></article><article><span><Icon name="message" /></span><h3>Explain the Options</h3><p>Provide clear information about the recommended work and practical next steps.</p></article><article><span><Icon name="home-check" /></span><h3>Work With Care</h3><p>Approach the electrical work with attention to safety, reliability, and respect for the property.</p></article></div></div></section>
  <section class="cta about-cta"><div class="shell cta__inner"><div><p class="eyebrow">Start Your Project</p><h2>Ready to talk about your electrical needs?</h2></div><div class="cta__actions"><a class="button cta__primary" href="/contact/#quote-form">Request a Free Quote</a><a class="button button--outline" href={`tel:${site.telephone}`}><Icon name="phone" /> Call {site.phone}</a><a class="cta__whatsapp" href="https://wa.me/17788798210" target="_blank" rel="noopener noreferrer">WhatsApp <Icon name="arrow" /></a></div></div></section>
</BaseLayout>
