---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
const title = 'About Pacific Spirit Electrical | Vancouver, BC';
const description = 'Learn about Pacific Spirit Electrical, a residential electrical service focused on Vancouver and Greater Vancouver homeowners.';
---
<BaseLayout {title} {description} path="/about"><section class="page-hero"><div class="shell"><p class="eyebrow">About us</p><h1>Electrical work with a Pacific Northwest point of view.</h1><p>{site.tagline} Pacific Spirit Electrical is focused on helping residential homeowners in Vancouver and Greater Vancouver with their electrical needs.</p></div></section><section class="section section--white"><div class="shell copy"><p class="eyebrow">Our approach</p><h2>Keep the work clear, considered, and connected to your home.</h2><p>Every home has its own history, priorities, and next project. Whether you are investigating an electrical issue, updating an older system, or planning for an EV charger or heat pump, a useful starting point is a clear conversation about the space and what you are hoping to accomplish.</p><p>Pacific Spirit Electrical is built around residential service for Vancouver-area homeowners. The focus is practical electrical work and direct communication from first inquiry onward.</p></div></section><section class="section"><div class="shell grid reason-grid"><article class="reason" style="border-color:var(--line)"><h3>Residential focus</h3><p>Attention on the systems and decisions that matter in a home.</p></article><article class="reason" style="border-color:var(--line)"><h3>Vancouver area</h3><p>Serving homeowners throughout Vancouver and Greater Vancouver.</p></article><article class="reason" style="border-color:var(--line)"><h3>Built for the next step</h3><p>Help for immediate electrical needs and future-focused home improvements.</p></article></div></section><section class="cta"><div class="shell cta__inner"><div><p class="eyebrow">Let’s connect</p><h2>Have a residential electrical project in mind?</h2><p>Send an email with a short description of what you need help with.</p></div><a class="button" href={`mailto:${site.email}`}><Icon name="mail" /> Email us</a></div></section></BaseLayout>
