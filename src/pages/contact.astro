---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { services, site } from '../data/site';
const title = 'Contact Pacific Spirit Electrical | Vancouver, BC';
const description = 'Contact Pacific Spirit Electrical for residential electrical work in Vancouver and Greater Vancouver. Email us to discuss your project.';
---
<BaseLayout {title} {description} path="/contact"><section class="page-hero"><div class="shell"><p class="eyebrow">Contact</p><h1>Let’s talk about your home.</h1><p>For residential electrical work in Vancouver and Greater Vancouver, email Pacific Spirit Electrical or send a project inquiry below.</p></div></section><section class="section section--white"><div class="shell contact-grid"><div><p class="eyebrow">Request a quote</p><h2>Tell us what is on your list.</h2><div class="contact-card"><p>For questions about residential electrical services, upgrades, lighting, EV chargers, heat pumps, renovations, and repairs:</p><a href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a></div><div class="notice"><strong>Phone</strong><br />Phone details coming soon.<br /><br /><strong>Service area</strong><br />{site.serviceArea}</div><p class="notice">Please include your Vancouver or Greater Vancouver location and a short description of your project.</p></div><form class="contact-form" method="post" action="#" aria-label="Project inquiry form"><div class="grid" style="grid-template-columns:1fr 1fr"><label class="field">Name<input name="name" autocomplete="name" required /></label><label class="field">Email<input name="email" type="email" autocomplete="email" required /></label></div><label class="field">Location<input name="location" autocomplete="address-level2" placeholder="City or neighbourhood" required /></label><label class="field">Service interest<select name="service"><option value="">Select a service</option>{services.map((service) => <option>{service.title}</option>)}<option>Other residential electrical work</option></select></label><label class="field">How can we help?<textarea name="message" required placeholder="Please share a brief description of your project."></textarea></label><p class="form-note">This form is ready to connect to a form service or custom backend. Until then, please email us directly.</p><a class="button form-button" href={`mailto:${site.email}?subject=Free%20Quote%20Request`}><Icon name="mail" /> Request a Quote</a></form></div></section></BaseLayout>
