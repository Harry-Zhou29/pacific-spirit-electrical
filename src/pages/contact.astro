---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { services, site } from '../data/site';
const title = 'Request an Electrical Quote | Vancouver & Lower Mainland';
const description = 'Request an electrical quote from Pacific Spirit Electrical for residential and light commercial projects in Vancouver and the Lower Mainland.';
---

<BaseLayout {title} {description} path="/contact/">
  <section class="page-hero contact-hero">
    <div class="shell contact-hero__grid">
      <div>
        <p class="eyebrow">Contact Pacific Spirit Electrical</p>
        <h1>Let’s discuss your electrical project.</h1>
        <p>Tell us what you need and where the project is located. Contact us by phone, WhatsApp, email, or the quote form below.</p>
      </div>
      <aside class="contact-hero__panel" aria-labelledby="get-in-touch">
        <h2 id="get-in-touch">Get in Touch</h2>
        <div class="contact-hero__links">
          <a href={`tel:${site.telephone}`}><Icon name="phone" /><span><strong>Call {site.phone}</strong><small>Speak with Pacific Spirit Electrical</small></span></a>
          <a href="https://wa.me/17788798210" target="_blank" rel="noopener noreferrer"><Icon name="message" /><span><strong>WhatsApp</strong><small>Send us a message</small></span></a>
          <a href={`mailto:${site.email}`}><Icon name="mail" /><span><strong>{site.email}</strong><small>Email your project details</small></span></a>
          <div><Icon name="clipboard-check" /><span><strong>Free Estimates</strong><small>A clear starting point for your project</small></span></div>
          <div><Icon name="location" /><span><strong>Vancouver &amp; the Lower Mainland</strong><small>Local electrical service</small></span></div>
          <div><Icon name="globe" /><span><strong>Languages</strong><small>English · Mandarin Chinese · Spanish assistance available</small></span></div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--white contact-quote">
    <div class="shell contact-grid">
      <div class="contact-quote__intro">
        <p class="eyebrow">Request a Quote</p>
        <h2>Tell us about your project.</h2>
        <h3>Helpful details to include</h3>
        <ul class="contact-checklist">
          <li><Icon name="clipboard-check" /> Project location</li>
          <li><Icon name="clipboard-check" /> Type of electrical work</li>
          <li><Icon name="clipboard-check" /> A brief description of the issue or project</li>
          <li><Icon name="clipboard-check" /> Preferred way to be contacted</li>
        </ul>
        <p>Photos can be sent afterward by email or WhatsApp.</p>
        <div class="contact-alternatives">
          <a href={`tel:${site.telephone}`}><Icon name="phone" /> {site.phone}</a>
          <a href="https://wa.me/17788798210" target="_blank" rel="noopener noreferrer"><Icon name="message" /> WhatsApp</a>
          <a href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a>
        </div>
      </div>

      <form class="contact-form" aria-label="Project inquiry form" novalidate>
        <div class="contact-form__fields">
          <div class="contact-form__primary-fields">
            <label class="field"><span class="field__label">Name <span class="field__required" aria-hidden="true">*</span></span><input name="name" autocomplete="name" required /></label>
            <label class="field"><span class="field__label">Location <span class="field__required" aria-hidden="true">*</span></span><select name="location_choice" autocomplete="address-level2" required><option value="">Select your location</option><option>Vancouver</option><option>Burnaby</option><option>Richmond</option><option>North Vancouver</option><option>West Vancouver</option><option>New Westminster</option><option>Other Lower Mainland Area</option><option>Not Sure</option></select></label>
            <label class="field"><span class="field__label">Email</span><input name="email" type="email" autocomplete="email" /></label>
            <label class="field"><span class="field__label">Phone</span><input name="phone" type="tel" inputmode="tel" autocomplete="tel" aria-describedby="phone-error" /><span class="field-error" id="phone-error" aria-live="polite"></span></label>
            <p class="form-note contact-form__contact-note">Please provide at least one of email or phone.</p>
          </div>
          <label class="field contact-form__other-location" hidden>City or community <span aria-hidden="true">*</span><input name="other_location" autocomplete="address-level2" /></label>
          <label class="field">Service interest<select name="service"><option value="">Select a service</option>{services.map((service) => <option value={service.title}>{service.title}</option>)}<option value="Other electrical work">Other electrical work</option></select></label>
          <fieldset class="contact-method">
            <legend>Preferred contact method</legend>
            <label><input type="radio" name="preferred_contact" value="Email" checked /> Email</label>
            <label><input type="radio" name="preferred_contact" value="Phone" /> Phone</label>
            <label><input type="radio" name="preferred_contact" value="WhatsApp" /> WhatsApp</label>
          </fieldset>
          <label class="field">Project description <span aria-hidden="true">*</span><textarea name="message" required placeholder="Please share a brief description of your project."></textarea></label>
          <div class="contact-honeypot" aria-hidden="true"><label>Company website<input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
          <button class="button form-button" type="submit">Request a Free Quote</button>
          <p class="contact-form__status" role="status" aria-live="polite"></p>
        </div>
        <div class="contact-success" role="status" aria-live="polite" tabindex="-1" hidden>
          <svg class="contact-success__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m7.5 12 3 3 6-7"></path></svg>
          <p class="eyebrow">Request Received</p>
          <h2>Thank you — your request has been received.</h2>
          <p>Your project details have been sent to Pacific Spirit Electrical. We’ll review them and follow up using your preferred contact method.</p>
          <div class="contact-success__actions">
            <button class="button button--outline contact-success__again" type="button">Submit another request</button>
            <a href={`tel:${site.telephone}`}><Icon name="phone" /> Call {site.phone}</a>
            <a href="https://wa.me/17788798210" target="_blank" rel="noopener noreferrer"><Icon name="message" /> WhatsApp</a>
          </div>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  const status = form?.querySelector<HTMLElement>('.contact-form__status');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const fields = form?.querySelector<HTMLElement>('.contact-form__fields');
  const success = form?.querySelector<HTMLElement>('.contact-success');
  const submitAnother = form?.querySelector<HTMLButtonElement>('.contact-success__again');
  const firstField = form?.querySelector<HTMLInputElement>('input[name="name"]');
  const locationChoice = form?.querySelector<HTMLSelectElement>('select[name="location_choice"]');
  const otherLocationField = form?.querySelector<HTMLElement>('.contact-form__other-location');
  const otherLocationInput = form?.querySelector<HTMLInputElement>('input[name="other_location"]');
  const phoneInput = form?.querySelector<HTMLInputElement>('input[name="phone"]');
  const phoneError = form?.querySelector<HTMLElement>('#phone-error');

  const phoneErrorMessage = 'Enter a valid 10-digit phone number, for example (778) 879-8210.';

  const clearPhoneError = () => {
    if (!phoneInput || !phoneError) return;
    phoneInput.removeAttribute('aria-invalid');
    phoneInput.setCustomValidity('');
    phoneError.textContent = '';
  };

  const normalizePhone = () => {
    if (!phoneInput || !phoneError) return null;
    const rawPhone = phoneInput.value.trim();
    clearPhoneError();
    if (!rawPhone) return '';

    let digits = rawPhone.replace(/\D/g, '');
    if (digits.length === 11 && digits.startsWith('1')) digits = digits.slice(1);
    const usesAcceptedCharacters = /^\+?[\d\s().-]+$/.test(rawPhone);
    const usesValidCountryCode = !rawPhone.startsWith('+') || /^\+1(?:[\s().-]|\d)/.test(rawPhone);
    const isPlausible = usesAcceptedCharacters && usesValidCountryCode && /^[2-9]\d{2}[2-9]\d{6}$/.test(digits);

    if (!isPlausible) {
      phoneInput.setAttribute('aria-invalid', 'true');
      phoneInput.setCustomValidity(phoneErrorMessage);
      phoneError.textContent = phoneErrorMessage;
      return null;
    }

    const formatted = `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;
    phoneInput.value = formatted;
    return formatted;
  };

  const syncOtherLocation = () => {
    if (!locationChoice || !otherLocationField || !otherLocationInput) return;
    const needsDetails = locationChoice.value === 'Other Lower Mainland Area';
    otherLocationField.hidden = !needsDetails;
    otherLocationInput.required = needsDetails;
    if (!needsDetails) otherLocationInput.value = '';
  };

  const resetFieldState = () => {
    clearPhoneError();
    syncOtherLocation();
    status && (status.textContent = '');
  };

  locationChoice?.addEventListener('change', syncOtherLocation);
  phoneInput?.addEventListener('blur', () => {
    if (phoneInput.value.trim()) normalizePhone();
  });
  phoneInput?.addEventListener('input', () => {
    const rawPhone = phoneInput.value.trim();
    if (!rawPhone) {
      clearPhoneError();
      return;
    }
    let digits = rawPhone.replace(/\D/g, '');
    if (digits.length === 11 && digits.startsWith('1')) digits = digits.slice(1);
    const usesAcceptedCharacters = /^\+?[\d\s().-]+$/.test(rawPhone);
    const usesValidCountryCode = !rawPhone.startsWith('+') || /^\+1(?:[\s().-]|\d)/.test(rawPhone);
    if (usesAcceptedCharacters && usesValidCountryCode && /^[2-9]\d{2}[2-9]\d{6}$/.test(digits)) clearPhoneError();
  });

  const showSuccess = () => {
    if (!form || !fields || !success) return;
    form.reset();
    resetFieldState();
    fields.hidden = true;
    success.hidden = false;
    success.focus();
    success.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  submitAnother?.addEventListener('click', () => {
    if (!fields || !success) return;
    success.hidden = true;
    fields.hidden = false;
    resetFieldState();
    firstField?.focus();
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || !submitButton) return;

    const phone = normalizePhone();
    if (phone === null) {
      phoneInput?.focus();
      return;
    }

    const data = new FormData(form);
    const email = String(data.get('email') || '').trim();
    const location = locationChoice?.value === 'Other Lower Mainland Area'
      ? String(data.get('other_location') || '').trim()
      : String(data.get('location_choice') || '').trim();
    const honeypot = String(data.get('company_website') || '').trim();

    status.textContent = '';
    if (!form.checkValidity() || (!email && !phone)) {
      if (!email && !phone) status.textContent = 'Please provide at least one of email or phone.';
      form.reportValidity();
      return;
    }

    if (honeypot) {
      showSuccess();
      return;
    }

    submitButton.disabled = true;
    submitButton.textContent = 'Sending…';

    try {
      const response = await fetch('https://n8n.pacificspiritelectrical.ca/webhook/6f8c3557-9893-4723-b597-dadd4ca567ed', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: String(data.get('name') || '').trim(),
          email,
          phone,
          location,
          service: String(data.get('service') || ''),
          preferred_contact: String(data.get('preferred_contact') || ''),
          message: String(data.get('message') || '').trim(),
          source: 'Pacific Spirit Electrical Website',
        }),
      });

      if (!response.ok) throw new Error(`Webhook returned ${response.status}`);
      showSuccess();
    } catch {
      status.textContent = 'We couldn’t send your request. Please call, email, or message us on WhatsApp.';
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Request a Free Quote';
    }
  });
</script>
