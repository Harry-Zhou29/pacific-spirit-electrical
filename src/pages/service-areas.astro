---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
const title = 'Electrical Service Areas | Vancouver & Lower Mainland';
const description = 'Pacific Spirit Electrical serves Vancouver, Burnaby, Richmond, the North Shore, New Westminster, and nearby Lower Mainland communities.';

const areas = [
  { name: 'Vancouver', description: 'Residential and light commercial electrical service across Vancouver neighbourhoods.' },
  { name: 'Burnaby', description: 'Electrical repairs, upgrades, installations, and project support.' },
  { name: 'Richmond', description: 'Practical electrical service for homes and light commercial properties.' },
  { name: 'North Shore', description: 'Service availability for North Vancouver and West Vancouver projects.' },
  { name: 'New Westminster', description: 'Electrical service for established homes, renovations, and property improvements.' },
  { name: 'Nearby Lower Mainland Areas', description: 'Contact us to confirm availability based on location, project scope, and scheduling.' },
];
---

<BaseLayout {title} {description} path="/service-areas/">
  <section class="page-hero service-areas-hero">
    <div class="shell service-areas-hero__grid">
      <div>
        <p class="eyebrow">Where We Work</p>
        <h1>Electrical service across Vancouver &amp; nearby communities.</h1>
        <p>Vancouver-based residential and light commercial electrical service across Vancouver and surrounding Lower Mainland communities.</p>
        <div class="service-areas-hero__actions">
          <a class="button service-areas-hero__primary" href="/contact/#quote-form">Request a Free Quote</a>
          <a class="button button--outline" href={`tel:${site.telephone}`}><Icon name="phone" /> Call {site.phone}</a>
        </div>
      </div>
      <aside class="service-areas-hero__panel" aria-labelledby="primary-service-areas">
        <Icon name="location" />
        <h2 id="primary-service-areas">Primary Service Areas</h2>
        <ul>{areas.map((area) => <li>{area.name}</li>)}</ul>
        <p>Contact us to confirm availability for your location and project.</p>
      </aside>
    </div>
  </section>

  <section class="section section--white service-areas-content">
    <div class="shell">
      <div class="service-areas-content__head">
        <p class="eyebrow">Local Coverage</p>
        <h2>Vancouver-based service, with practical coverage.</h2>
        <p>Service availability depends on location, project scope, and scheduling. These are the primary communities served by Pacific Spirit Electrical.</p>
      </div>
      <div class="service-areas-grid">
        {areas.map((area) => (
          <article class="service-area-card">
            <Icon name="location" />
            <h3>{area.name}</h3>
            <p>{area.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta service-areas-cta">
    <div class="shell cta__inner">
      <div>
        <p class="eyebrow">Check Your Location</p>
        <h2>Not sure whether your property is within the service area?</h2>
        <p>Share your location and a short description of the electrical work you are considering.</p>
      </div>
      <div class="cta__actions">
        <a class="button service-areas-cta__primary" href="/contact/#quote-form">Request a Free Quote</a>
        <a class="button button--outline" href={`tel:${site.telephone}`}><Icon name="phone" /> Call {site.phone}</a>
        <a class="cta__whatsapp" href="https://wa.me/17788798210" target="_blank" rel="noopener noreferrer">WhatsApp <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</BaseLayout>
