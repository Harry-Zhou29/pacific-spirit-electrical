---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
const title = 'Electrical Service Areas | Vancouver & Greater Vancouver';
const description = 'Pacific Spirit Electrical provides residential electrical services for homeowners in Vancouver and Greater Vancouver, British Columbia.';
---
<BaseLayout {title} {description} path="/service-areas"><section class="page-hero"><div class="shell"><p class="eyebrow">Where we work</p><h1>Vancouver and Greater Vancouver residential electrical service.</h1><p>Pacific Spirit Electrical is here for homeowners in Vancouver and across the Greater Vancouver area.</p></div></section><section class="section section--white"><div class="shell area-panel"><div><p class="eyebrow">Our service area</p><h2>Local service for the homes around us.</h2><p>From a small electrical concern to a home improvement plan, Pacific Spirit Electrical serves residential customers across Vancouver and Greater Vancouver.</p><p>Not sure whether your home is within the service area? Send an email with your location and a brief outline of the work you are considering.</p><a class="button button--outline" href={`mailto:${site.email}?subject=Service%20area%20inquiry`}><Icon name="mail" /> Ask about your area</a></div><div class="area-art" aria-hidden="true"><Icon name="map" /></div></div></section><section class="section"><div class="shell copy"><p class="eyebrow">Planning electrical work</p><h2>A useful first note includes the essentials.</h2><ul class="list"><li>Your neighbourhood or municipality</li><li>A short description of the electrical issue or project</li><li>Whether the work is connected to a renovation, EV charger, heat pump, lighting update, or another home improvement</li></ul></div></section></BaseLayout>
