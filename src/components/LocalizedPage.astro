---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizedPages, type Lang } from '../data/i18n';
import { site } from '../data/site';
interface Props { lang: Exclude<Lang, 'en'>; page: keyof typeof localizedPages.zh }
const { lang, page } = Astro.props;
const content = localizedPages[lang][page] as { title:string; description:string; eyebrow:string; heading:string; intro:string; sections: readonly (readonly [string,string])[] };
const path = `/${lang}/${page === 'home' ? '' : `${page}/`}`;
---
<BaseLayout title={content.title} description={content.description} path={path}>
  <section class="page-hero localized-hero"><div class="shell page-hero__inner"><p class="eyebrow">{content.eyebrow}</p><h1>{content.heading}</h1><p class="lead">{content.intro}</p>{page === 'home' && <div class="hero__actions"><a class="button" href={`/${lang}/contact/`}>{lang === 'zh' ? '免费询价' : 'Solicitar presupuesto'}</a><a class="button button--secondary" href={`/${lang}/services/`}>{lang === 'zh' ? '查看服务' : 'Ver servicios'}</a></div>}</div></section>
  <section class="section localized-content"><div class="shell"><div class="localized-grid">{content.sections.map(([title, body]) => <article class="card"><h2>{title}</h2><p>{body}</p>{page === 'contact' && title === (lang === 'zh' ? '报价表单' : 'Formulario de presupuesto') && <a class="text-link" href="/contact/">{lang === 'zh' ? '打开完整报价表单 →' : 'Abrir formulario completo →'}</a>}</article>)}</div>{page !== 'privacy' && <div class="localized-cta"><h2>{lang === 'zh' ? '准备好开始了吗？' : '¿Listo para empezar?'}</h2><p>{lang === 'zh' ? '告诉我们项目地点和需求，我们会尽快回复。' : 'Envíenos la ubicación y una breve descripción. Le responderemos lo antes posible.'}</p><div class="hero__actions"><a class="button" href={`mailto:${site.email}`}>{site.email}</a><a class="button button--secondary" href={`tel:${site.telephone}`}>{site.phone}</a></div></div>}</div></section>
</BaseLayout>
