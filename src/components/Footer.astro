---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { getLang, ui } from '../data/i18n';
const lang = getLang(Astro.url.pathname); const t = ui[lang]; const prefix = lang === 'en' ? '' : `/${lang}`;
---
<footer class="site-footer">
  <div class="shell footer__grid">
    <div class="footer-about"><a class="footer__brand" href={`${prefix}/`} aria-label="Pacific Spirit Electrical home"><img src="/images/pacific-spirit-electrical-logo-900.png" width="900" height="300" alt="Pacific Spirit Electrical" loading="lazy" decoding="async" /></a><p class="footer-tagline">{site.tagline}</p><p class="footer-creds">{site.qualification}<br />{site.businessType}</p><p class="footer-location">Vancouver &amp; the Lower Mainland, BC</p><p class="footer-languages"><Icon name="globe" /><span><strong>Languages</strong><br />English · 中文 · Español</span></p></div>
    <nav class="footer-navigation" aria-label="Footer navigation"><p class="eyebrow">{t.quick}</p><ul class="footer-links"><li><a href={`${prefix}/`}>{t.home}</a></li><li><a href={`${prefix}/services/`}>{t.services}</a></li><li><a href={`${prefix}/about/`}>{t.about}</a></li><li><a href={`${prefix}/service-areas/`}>{t.areas}</a></li><li><a href={`${prefix}/contact/`}>{t.contact}</a></li><li><a href={`${prefix}/privacy/`}>{t.privacy}</a></li></ul></nav>
    <div class="footer-contact"><p class="eyebrow">{t.touch}</p><p class="footer-contact__intro">{t.project}</p><a class="footer-phone" href={`tel:${site.telephone}`}><Icon name="phone" />{site.phone}</a><a class="footer-email" href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a><a class="footer-whatsapp" href="https://wa.me/17788798210" target="_blank" rel="noopener noreferrer"><Icon name="message" />WhatsApp</a><button class="footer-wechat wechat-open" type="button" data-wechat-open><Icon name="wechat" />WeChat</button><a class="button footer-quote" href={`${prefix}/contact/#quote-form`}>{t.request}</a></div>
    <div class="footer-social"><p class="eyebrow">{t.follow}</p><div class="social-grid"><a href={site.social.instagram} target="_blank" rel="noopener noreferrer"><strong>Instagram</strong><span>@pacificspiritelectrical</span></a><a href={site.social.facebook} target="_blank" rel="noopener noreferrer"><strong>Facebook</strong><span>Pacific Spirit Electrical</span></a><div class="social-card"><strong>{lang === 'zh' ? '小红书' : 'RedNote'}</strong><span>{site.social.xiaohongshuId}</span></div><button class="social-card social-card--button wechat-open" type="button" data-wechat-open><strong>WeChat</strong><span>{t.viewWechat} →</span></button></div><button class="wechat-copy footer-copy" type="button" data-wechat={site.social.wechatId}>{t.copyWechat}: {site.social.wechatId}</button></div>
  </div>
  <div class="shell footer__bottom"><p>© {new Date().getFullYear()} {site.name}</p><a href="#top">{t.back} ↑</a></div>
</footer>
<dialog class="wechat-dialog" data-wechat-dialog aria-labelledby="wechat-dialog-title"><div class="wechat-dialog__head"><h2 id="wechat-dialog-title">WeChat</h2><button type="button" data-wechat-close aria-label={t.close}>×</button></div><img src="/images/wechat-qr-harry.png" width="888" height="1191" alt={t.scanWechat} loading="lazy" /><p>{t.scanWechat}</p><p class="wechat-dialog__id">WeChat ID: <strong>{site.social.wechatId}</strong></p><button class="button wechat-copy" type="button" data-wechat={site.social.wechatId}>{t.copyWechat}</button></dialog>
<a class="mobile-contact" href={`tel:${site.telephone}`}><Icon name="phone" /> {t.call} {site.phone}</a>
<script is:inline define:vars={{ copied: t.copied }}>
  document.querySelectorAll('.wechat-copy').forEach((button) => button.addEventListener('click', async () => { await navigator.clipboard.writeText(button.dataset.wechat); const old = button.textContent; button.textContent = copied; setTimeout(() => button.textContent = old, 1600); }));
  const wechatDialog = document.querySelector('[data-wechat-dialog]');
  document.querySelectorAll('[data-wechat-open]').forEach((button) => button.addEventListener('click', () => wechatDialog?.showModal()));
  document.querySelector('[data-wechat-close]')?.addEventListener('click', () => wechatDialog?.close());
  wechatDialog?.addEventListener('click', (event) => { if (event.target === wechatDialog) wechatDialog.close(); });
</script>
