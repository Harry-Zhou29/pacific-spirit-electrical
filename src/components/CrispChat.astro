<script is:inline>
  window.$crisp = [];
  window.CRISP_WEBSITE_ID = 'd068e0ce-c6ce-490a-82e7-b7a06c3d5331';

  const path = window.location.pathname;
  const locale = path.startsWith('/zh/') ? 'zh' : path.startsWith('/es/') ? 'es' : 'en';

  window.CRISP_RUNTIME_CONFIG = { locale };
  window.$crisp.push(['safe', true]);
  window.$crisp.push(['config', 'position:reverse', [true]]);
  window.$crisp.push(['config', 'color:theme', ['blue']]);
  window.$crisp.push(['config', 'availability:tooltip', [false]]);

  const crispScript = document.createElement('script');
  crispScript.src = 'https://client.crisp.chat/l.js';
  crispScript.async = true;
  document.head.appendChild(crispScript);
</script>
